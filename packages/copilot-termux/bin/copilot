#!/bin/sh
set -eu
SELF="$0"
while [ -L "${SELF}" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "${SELF}")" && pwd)
  SELF="$(readlink "${SELF}")"
  case "${SELF}" in /*) ;; *) SELF="${DIR}/${SELF}" ;; esac
done
PACKAGE_DIR=$(CDPATH= cd -- "$(dirname -- "${SELF}")/.." && pwd)

if [ "${1:-}" = "update" ]; then
  shift
  exec node "${PACKAGE_DIR}/lib/check-updates.js" update "$@"
fi

CACHE_DIR="${HOME}/.copilot-termux"
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"

if ! command -v node >/dev/null 2>&1; then
  echo "[copilot-termux] ERROR: node not found in PATH. Install it: pkg install nodejs" >&2
  exit 1
fi

MANIFEST="${PACKAGE_DIR}/config/manifest.json"
VER=$(node -e 'try{const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).copilot.version;if(typeof v==="string"&&/^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?$/.test(v))process.stdout.write(v);else process.exit(2)}catch(e){process.exit(2)}' "${MANIFEST}") || VER=""
if [ -z "${VER}" ]; then
  echo "[copilot-termux] Broken package (manifest unreadable or invalid). Reinstall: npm install -g @bash0816/copilot-termux" >&2
  exit 1
fi

COPILOT_BIN="${CACHE_DIR}/${VER}/copilot"
if [ ! -f "${COPILOT_BIN}" ]; then
  echo "[copilot-termux] copilot ${VER} is not set up. Run: copilot-termux setup" >&2
  exit 1
fi

_GLIBC_LD="${PREFIX}/glibc/lib/ld-linux-aarch64.so.1"
_GLIBC_LIBS="${PREFIX}/glibc/lib"

if [ ! -f "${_GLIBC_LD}" ]; then
  echo "[copilot-termux] ERROR: glibc not found. Please install: pkg install glibc-repo && pkg install glibc" >&2
  exit 1
fi

_SSL_CERT="${PREFIX}/etc/tls/cert.pem"
_SSL_CERT_DIR="${PREFIX}/etc/tls"
if [ ! -r "${_SSL_CERT}" ]; then
  echo "[copilot-termux] ERROR: CA bundle not readable: ${_SSL_CERT}" >&2
  echo "[copilot-termux] Run: pkg install ca-certificates" >&2
  exit 1
fi

exec env -u LD_PRELOAD \
  SSL_CERT_FILE="${_SSL_CERT}" \
  SSL_CERT_DIR="${_SSL_CERT_DIR}" \
  COPILOT_TERMUX_GLIBC_MODE=1 \
  COPILOT_AUTO_UPDATE=false \
  "${_GLIBC_LD}" --library-path "${_GLIBC_LIBS}" \
  "${COPILOT_BIN}" \
  "$@"
